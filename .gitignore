# Generated data tables and plots — deterministic from config.yaml + the
# generator (§23 seeds per business). Regenerate with:
#     python -m generator.generate
# Not committed: transactions.csv alone runs ~720MB at full scale (N=11,000),
# well past GitHub's 100MB per-file limit, and committed data drifts silently
# out of sync with the config that is supposed to define it.
data/*
!data/.gitkeep

# Pre-git manual snapshot of the generator taken before the schema-alignment
# rewrite (2026-09-14). Superseded by git history now that this is a repo —
# kept locally for reference, not part of the tracked project.
_backup_pre_schema_align/

# Python
__pycache__/
*.pyc
.ruff_cache/
*.egg-info/
.venv/
venv/

